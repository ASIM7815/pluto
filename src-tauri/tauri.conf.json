{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluto",
  "version": "1.0.0",
  "identifier": "com.pluto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "PLUTO",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "center": true,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "PLUTO - Linux desktop AI assistant",
    "longDescription": "PLUTO is a true Linux desktop AI assistant. It runs natively on your machine with a Rust/Tauri backend: real filesystem tools, screenshots (X11 and Wayland), native clipboard, application launching, system monitoring, local TTS, and safe, confirmation-gated command execution. No Python, no localhost servers, no cloud dependency.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "librsvg2-2",
          "libxcb1",
          "libssl3",
          "xdg-utils",
          "imagemagick | scrot | grim | gnome-screenshot"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
