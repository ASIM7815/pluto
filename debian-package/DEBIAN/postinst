#!/bin/bash
set -e

echo "Installing PLUTO AI Assistant..."

# Create pluto user directory if doesn't exist
if [ ! -d "/opt/pluto" ]; then
    echo "Creating PLUTO directory..."
fi

# Install Python dependencies
echo "Installing Python dependencies..."
cd /opt/pluto/pluto-backend
if [ ! -d "venv" ]; then
    python3 -m venv venv
fi
source venv/bin/activate
pip install --quiet --upgrade pip
pip install --quiet -r requirements.txt

# Install Playwright browsers
echo "Installing browser automation support..."
python -m playwright install chromium 2>/dev/null || true

# Install frontend dependencies
echo "Installing frontend dependencies..."
cd /opt/pluto
if [ -f "package.json" ]; then
    npm install --silent 2>/dev/null || echo "Note: npm not found, skipping frontend build"
fi

# Create browser profile directory
mkdir -p ~/.pluto/browser-profile

# Update icon cache
if command -v update-icon-caches >/dev/null 2>&1; then
    update-icon-caches /usr/share/icons/hicolor
fi

# Update desktop database
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications
fi

echo ""
echo "✅ PLUTO AI Assistant installed successfully!"
echo ""
echo "To start PLUTO:"
echo "  1. Launch from Applications menu"
echo "  2. Or run: /opt/pluto/start.sh"
echo ""
echo "PLUTO will open in your browser at: http://localhost:3000"
echo ""

exit 0
