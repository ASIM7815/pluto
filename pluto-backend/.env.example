# ===== PLUTO Backend Environment =====
# Copy to .env and add API keys to enable real GPT-OSS 120B + ElevenLabs.
# With empty keys the backend runs in MOCK MODE (scripted planner + browser TTS)
# so the whole Listen -> ... -> Speak -> Listen loop still works end-to-end.

# --- Application ---
PLUTO_ENV=development
PLUTO_BACKEND_HOST=0.0.0.0
PLUTO_BACKEND_PORT=8765
PLUTO_LOG_LEVEL=INFO

# --- Security ---
PLUTO_SECRET_KEY=change-this-in-production
PLUTO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- GPT-OSS 120B (Groq, OpenAI-compatible) ---
# Get a key from https://console.groq.com
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1
GPT_OSS_MODEL=openai/gpt-oss-120b
PLUTO_LLM_TEMPERATURE=0.7
PLUTO_LLM_MAX_TOKENS=4096

# --- ElevenLabs TTS ---
# Get a key from https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Agent loop behaviour ---
PLUTO_AUTO_SPEAK=true
PLUTO_AUTO_LISTEN=true
PLUTO_MAX_ITERATIONS=10
PLUTO_STREAM_TEXT=false
PLUTO_SESSION_IDLE_MINUTES=120

# --- Browser automation ---
# "auto" = headless only when no display; set true/false to force.
PLUTO_BROWSER_HEADLESS=auto

# --- Messaging integration (optional) ---
# Executable invoked as: <command> <recipient> <message> ; exit 0 = delivered.
# e.g. PLUTO_MESSAGING_COMMAND=/home/user/pluto/pluto-messaging-bridge.sh
PLUTO_MESSAGING_COMMAND=

# --- Filesystem sandbox (comma-separated; ~ expands to home) ---
PLUTO_ALLOWED_PATHS=/home/user/Desktop,/home/user/Documents,/home/user/Downloads,/home/user/Projects,/home/user/pluto

# --- Permissions ---
PLUTO_AUTO_APPROVE_SAFE=true
PLUTO_REQUIRE_CONFIRMATION_DANGEROUS=true
