# ===== PLUTO Backend Environment =====
# PLUTO runs 100% local by default: its own offline scikit-learn brain, local
# (offline-first) TTS/STT and its own SQLite memory. No API key is required.
# Empty string = feature disabled. Copy to .env to override any value.

# --- Application ---
PLUTO_ENV=development
PLUTO_BACKEND_HOST=0.0.0.0
PLUTO_BACKEND_PORT=8765
PLUTO_LOG_LEVEL=INFO

# --- Security ---
PLUTO_SECRET_KEY=change-this-in-production
PLUTO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Persist per-session context across restarts (Phase 3) ---
PLUTO_PERSIST_CONTEXT=true

# --- LEGACY / OPTIONAL external providers (NOT used by the local brain) ---
# PLUTO's active path never calls these; they are kept only for backwards
# compatibility of unused modules. Leave blank to stay fully offline.
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1
GPT_OSS_MODEL=openai/gpt-oss-120b
PLUTO_LLM_TEMPERATURE=0.7
PLUTO_LLM_MAX_TOKENS=4096

# --- LEGACY / OPTIONAL ElevenLabs TTS (external; PLUTO now defaults to local TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Agent loop behaviour ---
PLUTO_AUTO_SPEAK=true
PLUTO_AUTO_LISTEN=true
PLUTO_MAX_ITERATIONS=10
PLUTO_STREAM_TEXT=false
PLUTO_SESSION_IDLE_MINUTES=120

# --- Browser automation ---
# "auto" = headless only when no display; set true/false to force.
PLUTO_BROWSER_HEADLESS=auto

# --- Messaging integration (optional) ---
# Executable invoked as: <command> <recipient> <message> ; exit 0 = delivered.
# e.g. PLUTO_MESSAGING_COMMAND=/home/user/pluto/pluto-messaging-bridge.sh
PLUTO_MESSAGING_COMMAND=

# --- Filesystem sandbox (comma-separated; ~ expands to home) ---
# Leave empty to allow the PLUTO user's home + standard folders
# (Desktop, Documents, Downloads, Pictures, Music, Videos, Projects...).
# Set explicitly to restrict/override, e.g.:
# PLUTO_ALLOWED_PATHS=/home/user/Desktop,/home/user/Documents,/home/user/Downloads,/home/user/Projects,/home/user/pluto,/home/user/Pictures
PLUTO_ALLOWED_PATHS=

# --- Permissions ---
PLUTO_AUTO_APPROVE_SAFE=true
PLUTO_REQUIRE_CONFIRMATION_DANGEROUS=true
